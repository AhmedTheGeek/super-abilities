{
	"name": "ahmedhussein/super-abilities",
	"description": "Advanced, capability-gated abilities that let AI agents manage a WordPress site through the core Abilities API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ahmed Hussein"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.8",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.8",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"SuperAbilities\\": "src/"
		}
	},
	"config": {
		"platform": {
			"php": "8.0.30"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"zip": "bash bin/build-zip.sh"
	},
	"scripts-descriptions": {
		"lint": "Check the code against the WordPress coding standards.",
		"lint:fix": "Fix what the coding standards checker can fix automatically.",
		"analyse": "Run static analysis.",
		"test": "Run the PHPUnit suites.",
		"zip": "Build a distributable plugin ZIP into dist/."
	}
}
